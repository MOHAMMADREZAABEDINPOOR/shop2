APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Minutes of inactivity before the login session expires (e.g. 120 = 2 hours, 10080 = 7 days)
SESSION_LIFETIME=120
# Close the session when the browser closes (true) or keep it for SESSION_LIFETIME (false)
SESSION_EXPIRE_ON_CLOSE=false
# Encrypt all session payloads at rest (recommended: true)
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Send session cookies over HTTPS only (auto-enabled in production)
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

# "Remember me" login persistence in minutes (default 576000 ≈ 400 days; 43200 = 30 days)
AUTH_REMEMBER_DURATION=576000
# Seconds before password-confirmation expires
AUTH_PASSWORD_TIMEOUT=10800

# HSTS max-age in seconds (production HTTPS only)
HSTS_MAX_AGE=31536000

# Product analytics (leave empty to disable). Providers: ga4, plausible
ANALYTICS_PROVIDER=
ANALYTICS_ID=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
